---
import { type CollectionEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import Main from "../layouts/Main.astro";

export async function getStaticPaths() {
  const posts = await getCollection("service");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"service">;

const post = Astro.props;
const firstBulletIndex = post.body.search(/^\* \*\*/m);
const intro = (firstBulletIndex === -1 ? post.body : post.body.slice(0, firstBulletIndex)).trim();
const items = [...post.body.matchAll(/^\* \*\*(.+?)\*\*\s*\n\s*(.+)$/gm)].map(
  ([, title, description]) => ({ title, description })
);
---

<Main
  title={post.data.title}
  description={post.data.description}
  image={post.data.thumbnail}
>
  <section class="section">
    <div class="container">
      <div class="breadcrumbs text-sm mb-6">
        <ul class="flex! flex-wrap">
          <li><a href="/">Home</a></li>
          <li>{post.data.title}</li>
        </ul>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold mb-6">
        {post.data.title}
      </h1>

      {post.data.thumbnail && (
        <Image
          src={post.data.thumbnail}
          alt={post.data.title}
          width="800"
          height="400"
          format="webp"
          quality={75}
          class="w-full max-w-2xl mx-auto h-auto aspect-2/1 rounded-xl object-cover mb-8 shadow-soft"
        />
      )}

      {intro && (
        <p class="text-white/70 max-w-2xl text-sm sm:text-base leading-relaxed mb-8">
          {intro}
        </p>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {items.map((item) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-premium hover:border-main/30">
            <h3 class="font-display font-semibold text-lg text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/contact"
          class="btn-brand"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Main>
