---
import Layout from "../layouts/Main.astro";

const packages = [
  {
    name: "Basic Website",
    description: "Get a professional online presence up and running.",
    price: "$1,500",
    period: "",
    cta: "Get Started",
    featured: false,
    features: [
      "Up to 5 pages (Home, Services, About, Gallery/Our Work, Contact)",
      "Responsive mobile design",
      "Contact form",
      "Photo gallery",
      "Basic SEO",
      "Social media links",
      "Google Maps",
      "Domain connection",
      "SSL certificate",
      "Website launch",
    ],
  },
  {
    name: "Advanced Website",
    description: "Designed to convert visitors into customers.",
    price: "$2,500",
    period: "",
    cta: "Get Started",
    featured: true,
    features: [
      "Everything in Basic",
      "Up to 8–10 pages",
      "Custom design",
      "Testimonials/reviews section",
      "Enhanced gallery",
      "Animations",
      "Stronger SEO setup",
      "Conversion-focused layout",
      "Performance optimization",
      "Google Analytics/Search Console setup",
      "Additional revisions",
    ],
  },
  {
    name: "Premium Website",
    description: "A highly customized site for growing businesses.",
    price: "$3,500–$5,000",
    period: "",
    cta: "Get Started",
    featured: false,
    features: [
      "Everything in Advanced",
      "Highly customized design",
      "10–15+ pages",
      "Individual service pages",
      "Advanced animations/interactions",
      "Advanced forms/integrations",
      "Advanced SEO",
      "Deeper performance optimization",
      "Custom functionality",
      "Priority development",
    ],
  },
  {
    name: "Custom Website",
    description: "Built for ecommerce, booking, and complex platforms.",
    price: "$5,000+",
    period: "starting at",
    cta: "Contact for a Quote",
    featured: false,
    features: [
      "Custom quote for ecommerce",
      "Booking systems",
      "Membership areas",
      "Customer portals",
      "Databases",
      "Complex integrations",
      "Other specialized functionality",
    ],
  },
];

const carePlans = [
  {
    name: "Hosting",
    description: "Keep it online.",
    price: "$29",
    period: "/month",
    cta: "Get Started",
    featured: false,
    features: [
      "Website hosting",
      "SSL certificate",
      "Uptime monitoring",
      "Basic backups",
      "Technical hosting maintenance",
      "Domain connection",
    ],
  },
  {
    name: "Website Care",
    description: "Keep it maintained.",
    price: "$99",
    period: "/month",
    cta: "Get Started",
    featured: true,
    features: [
      "Everything in Hosting",
      "Security & technical maintenance",
      "Backups",
      "Performance monitoring",
      "Up to 2 small content updates/month (text, photos, etc.)",
    ],
  },
  {
    name: "Website Growth",
    description: "Keep it improving.",
    price: "$199",
    period: "/month",
    cta: "Get Started",
    featured: false,
    features: [
      "Everything in Care",
      "Up to 5 small updates/month",
      "New sections/pages",
      "Performance optimization",
      "Basic SEO monitoring",
      "Priority support",
      "Monthly website review",
    ],
  },
  {
    name: "Custom Management",
    description: "Dedicated, hands-on management for active sites.",
    price: "$299+",
    period: "/month",
    cta: "Get Started",
    featured: false,
    features: [
      "Dedicated ongoing development",
      "Frequent changes",
      "SEO work",
      "New pages/features",
      "Integrations",
      "Priority support",
    ],
  },
];
---

<Layout title="Pricing">
  <section class="bg-dark text-white py-16 lg:py-24 relative overflow-hidden">
    <div
      class="absolute -top-24 left-1/2 -translate-x-1/2 w-[32rem] h-[20rem] bg-main/20 blur-3xl rounded-full -z-0 pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="container relative z-10">
      <div class="breadcrumbs text-sm mb-6">
        <ul class="flex! flex-wrap">
          <li><a href="/" class="text-white/60 hover:text-white">Home</a></li>
          <li class="text-white/60">Pricing</li>
        </ul>
      </div>

      <div class="text-center max-w-2xl mx-auto mb-14">
        <h1 class="uppercase">Website Packages</h1>
        <p class="text-white/70">
          Choose the package that fits your business. All pricing below is a
          one-time project cost — no subscriptions — and every project
          includes a mobile-responsive, SEO-ready website built to help you
          grow online.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
        {
          packages.map((pkg, i) => (
            <div
              class:list={[
                "border rounded-2xl p-6 flex flex-col relative transition-all duration-300",
                pkg.featured
                  ? "bg-main/10 border-main/50 shadow-glow-main lg:-translate-y-2 lg:scale-105"
                  : "bg-white/5 border-white/10 shadow-soft hover:-translate-y-1 hover:border-white/20",
              ]}
              data-reveal
              style={`--reveal-delay: ${i * 0.08}s`}
            >
              {pkg.featured && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-main text-white text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full shadow-soft">
                  Most Popular
                </span>
              )}
              <h3 class="font-display text-xl mb-1">
                {pkg.name}
              </h3>
              <p class="text-white/60 text-sm mb-6">{pkg.description}</p>

              <div class="mb-6">
                <span class:list={["text-3xl md:text-4xl font-bold", pkg.featured && "text-main"]}>{pkg.price}</span>
                {pkg.period && (
                  <div class="text-white/50 text-sm">{pkg.period}</div>
                )}
              </div>

              <a
                href="/contact"
                class={
                  pkg.featured
                    ? "btn-brand mb-6"
                    : "btn-brand-outline-light mb-6"
                }
              >
                {pkg.cta}
              </a>

              <ul class="grid gap-3 text-sm text-white/80">
                {pkg.features.map((feature) => (
                  <li class="flex gap-2">
                    <span class="text-main shrink-0">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="border-t border-white/10 mt-20 pt-20">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="uppercase">Want Us to Keep Maintaining Your Site?</h2>
          <p class="text-white/70">
            If you'd like us to host your site and keep making updates and
            improvements after launch, choose a monthly plan below.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
          {
            carePlans.map((plan, i) => (
              <div
                class:list={[
                  "border rounded-2xl p-6 flex flex-col relative transition-all duration-300",
                  plan.featured
                    ? "bg-main/10 border-main/50 shadow-glow-main lg:-translate-y-2 lg:scale-105"
                    : "bg-white/5 border-white/10 shadow-soft hover:-translate-y-1 hover:border-white/20",
                ]}
                data-reveal
                style={`--reveal-delay: ${i * 0.08}s`}
              >
                {plan.featured && (
                  <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-main text-white text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full shadow-soft">
                    Most Popular
                  </span>
                )}
                <h3 class="font-display text-xl mb-1">
                  {plan.name}
                </h3>
                <p class="text-white/60 text-sm mb-6">{plan.description}</p>

                <div class="mb-6">
                  <span class:list={["text-3xl md:text-4xl font-bold", plan.featured && "text-main"]}>
                    {plan.price}
                  </span>
                  <span class="text-white/50 text-sm">{plan.period}</span>
                </div>

                <a
                  href="/contact"
                  class={
                    plan.featured
                      ? "btn-brand mb-6"
                      : "btn-brand-outline-light mb-6"
                  }
                >
                  {plan.cta}
                </a>

                <ul class="grid gap-3 text-sm text-white/80">
                  {plan.features.map((feature) => (
                    <li class="flex gap-2">
                      <span class="text-main shrink-0">✓</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="text-center text-white/50 text-sm mt-10">
          Note: these care plans are only available for websites we've
          built — we don't offer support for third-party websites.
        </p>
      </div>
    </div>
  </section>
</Layout>
