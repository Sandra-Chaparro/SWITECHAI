---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { data, id, class: className, style } = Astro.props;
const reveal = "data-reveal" in Astro.props;
---

<article
  class:list={[
    "group h-full flex flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-premium hover:border-main/30",
    className,
  ]}
  data-reveal={reveal ? true : undefined}
  style={style}
>
  <a href={`/service/${id}`} class="h-full flex flex-col">
    <div class="overflow-hidden rounded-xl mb-4">
      <Image
        src={data.thumbnail}
        alt={data.title}
        width="500"
        height="250"
        format="webp"
        quality={75}
        class="w-full max-w-sm mx-auto h-auto aspect-2/1 object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>

    <h3 class="font-display font-semibold text-xl sm:text-2xl my-4 text-gray-900">{data.title}</h3>
    <p class="mb-4 mt-4 text-sm sm:text-base text-gray-600">{data.description}</p>

    <button
      class="btn-brand-outline mt-auto"
    >
      See details
      <Icon name="lucide:arrow-up-right" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </button>
  </a>
</article>
