---
import Navabar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";
import { Icon } from "astro-icon/components";

const isHome = Astro.url.pathname === "/";
---

<header class="header bg-dark text-white sticky top-0 z-50 transition-shadow duration-300">
  <div class="navbar w-full">
    <div
      class="container grid grid-cols-[80px_1fr] lg:grid-cols-[204px_1fr_auto] items-center"
    >
      <Logo />

      <Navabar />
      <div class="flex gap-3 ml-auto">
        <a
          href="/contact"
          class="hidden sm:flex btn-brand"
          >Contact Us</a
        >
        <div class="flex-none lg:hidden">
          <label
            for="my-drawer-2"
            aria-label="open sidebar"
            class="btn btn-square btn-ghost btn-lg ml-2"
          >
            <Icon name="lucide:menu" class="w-6 h-6" />
          </label>
        </div>
      </div>
    </div>
  </div>
</header>
