---
import { NAV_MENU } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
---

<div class="drawer-side z-[60]">
  <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"
    ><span class="sr-only">Open menu</span>
  </label>
  <div class="menu bg-dark text-white min-h-full w-80 p-4">
    <div class="flex items-center justify-between mb-4">
      <div class="w-20 shrink-0 overflow-hidden">
        <Logo mode="dark" />
      </div>
      <label
        for="my-drawer-2"
        aria-label="close sidebar"
        class="btn btn-square btn-ghost btn-sm shrink-0"
      >
        <Icon name="lucide:x" class="w-5 h-5" />
      </label>
    </div>
    <ul class="mt-2 gap-1">
      {
        NAV_MENU.map((item) => (
          <li>
            <HeaderLink href={item.url} class="py-3 px-2 text-base hover:bg-white/10 rounded-lg">
              {item.title}
            </HeaderLink>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-col gap-2 items-center w-full mt-auto">
      <a
        href="/contact"
        class="btn-brand hover:text-white! w-full"
        >Contact Us</a
      >
    </div>
  </div>
</div>
