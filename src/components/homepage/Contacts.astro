---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="section section-contacts scroll-mt-24">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <p class="kicker">Contact Us</p>
        <h3 class="font-semibold text-xl lg:text-[40px]">Get in Touch</h3>
        <div class="mt-10 grid gap-6">
          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-xl p-4 shadow-soft"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full ring-4 ring-main-soft w-13.5 h-13.5"
            >
              <Icon name="lucide:phone-call" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Call Us</p>
              <a href="tel:+526144667011">(972)-439-5165</a>
            </div>
          </div>

          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-xl p-4 shadow-soft"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full ring-4 ring-main-soft w-13.5 h-13.5"
            >
              <Icon name="lucide:mail" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Send Us Email</p>
              <a href="mailto:salvatierradigital@gmail.com">salvatierradigital@gmail.com</a>
            </div>
          </div>

          <!-- <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:map-pin" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Address</p>
              <a href="#"
                ><address class="not-italic">
                  Main St, Dallas, TX 75201
                </address></a
              >
            </div>
          </div> -->
        </div>
      </div>
      <div>
        <p class="text-sm mb-0">Contact Us</p>
        <h3 class="font-semibold text-xl lg:text-[40px] mb-3">Send us a message!</h3>
        <p class="">
          Tell us about your business and what you're looking to achieve — we'll follow up with next steps.
        </p>

        <!--<form action="/" method="POST" class="mt-8 grid gap-3">-->
        <form id="contact-form" class="mt-8 grid gap-3">
          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Name"
              class="input w-full validator"
              id="contact-name"
              name="contact_name"
              required
            />
            <p class="validator-hint hidden">Required</p>
          </fieldset>

          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Email"
              class="input w-full validator"
              id="contact-email"
              name="contact_email"
              required
            />
            <p class="validator-hint hidden">Requerido</p>
          </fieldset>
          <fieldset class="fieldset">
            <textarea
              class="textarea w-full validator"
              placeholder="Message"
              id="contact-msg"
              name="contact_msg"
              required></textarea>
            <p class="validator-hint hidden">Required</p>
          </fieldset>
          <p id="contact-form-error" class="text-red-500 text-sm hidden"></p>
          <button
            class="btn-brand lg:mr-auto"
            type="submit">Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
<script>
  const CONTACT_EMAIL = "salvatierradigital@gmail.com";

  const form = document.getElementById("contact-form");
  const errorEl = document.getElementById("contact-form-error");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    if (errorEl) {
      errorEl.textContent =
        `Something went wrong. Please email us directly at ${CONTACT_EMAIL} and we'll be happy to assist you.`;

      errorEl.classList.remove("hidden");
    }
  });
</script>