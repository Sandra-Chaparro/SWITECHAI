---
import ServiceCard from "../../components/card/ServiceCard.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("service")).slice(0, 3);
---

<section class="section section-services">
  <div class="container">
    <h2 class="capitalize">Siempre brindando el mejor servicio.</h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 border-b border-b-main pb-10"
    >
      <div>
        <p class="mb-3">
          Si el servicio que busca no aparece en la lista, comuníquese con nosotros. Estaremos encantados de ayudarle.
        </p>
      </div>
    </div>

    <p class="font-semibold mb-8 text-3xl mt-10 text-center">Servicios</p>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 relative"
    >
      {services.map((service) => <ServiceCard {...service} />)}
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href="/service"
        class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
        >Ver todos los servicios</a
      >
    </div>
  </div>
</section>
