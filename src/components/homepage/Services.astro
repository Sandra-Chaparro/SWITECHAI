---
import ServiceCard from "../../components/card/ServiceCard.astro";
import { getCollection } from "astro:content";

const services = await getCollection("service");
---

<section class="section section-services">
  <div class="container">
    <h2 class="capitalize">Everything You Need to Build, Launch, and Grow Online.</h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 border-b border-b-main/30 pb-10"
    >
      <div>
        <p class="mb-3">
          We build custom websites and software, and add AI and automation to help your business run smoother.
        </p>
      </div>
    </div>

    <p class="kicker justify-center mt-10 mb-2">Services</p>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 relative"
    >
      {services.map((service, i) => <ServiceCard {...service} data-reveal style={`--reveal-delay: ${i * 0.1}s`} />)}
    </div>
  </div>
</section>
