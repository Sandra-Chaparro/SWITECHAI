---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";
import img1 from "../../assets/services/websiteCreation.jpg";
import img2 from "../../assets/hero/world.jpg";
import img3 from "../../assets/hero/RobotImg.jpg";
import img4 from "../../assets/services/herobg1.jpg";

const slides = [
  {
    kicker: "We provide the solutions, you accomplish the goals.",
    heading: "Custom Software",
    description: "Custom web applications and tools built around how your business works, including booking systems, dashboards, customer portals, and more.",
    image: img2,
    href: "/service/s2",
  },
  {
    kicker: "Workflow Automation, Integrations & AI",
    heading: "AUTOMATE THE BUSY WORK.",
    description: "From automating repetitive tasks like customer follow-ups, data processing, and internal workflows to building custom AI chatbots trained on your business information, we create solutions that help your business work smarter and respond to customers instantly, 24/7.",
    image: img3,
    href: "/service/s3",
  },
  {
    kicker: "Websites •  SEO • Growth",
    heading: "DIGITAL SOLUTIONS FOR YOUR BUSINESS.",
    description: "Modern websites for your business—using the right strategies to help you get found online, build customer trust, and grow.",
    image: img1,
    href: "/service/s1",
  },
  {
    kicker: "Ongoing Support & Maintenance",
    heading: "Support that continues after launch.",
    description: "Get continued support for the websites, applications, and systems we build, with ongoing maintenance, updates, improvements, and technical assistance through a monthly plan.",
    image: img4,
    href: "/service/s4",
  },
];
---

<section class="section-hero hero-swiper relative overflow-hidden bg-dark h-[85vh] min-h-[560px] max-h-[820px]">
  <h1 class="sr-only">SWITECHAI — Websites, Software, AI Automation & SEO for Growing Businesses</h1>

  <Swiper id="heroSwiper" pagination={true}>
    {slides.map((slide, i) => (
      <div class="swiper-slide relative h-full">
        <Image
          src={slide.image}
          alt=""
          width={1600}
          height={900}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          format="webp"
          quality={70}
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10" aria-hidden="true"></div>

        <div class="container relative z-10 h-full flex items-end pb-20 lg:pb-28">
          <div class="max-w-xl text-white">
            <p class="kicker text-white/80">{slide.kicker}</p>
            <h2 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl leading-[1.05] mb-4">{slide.heading}</h2>
            <p class="text-white/80 max-w-md mb-6">{slide.description}</p>
            <div class="flex flex-wrap gap-4">
              <a href="/contact" class="btn-brand btn-lg">Start Project</a>
              <a href={slide.href} class="btn-brand-outline-light btn-lg">View Services</a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </Swiper>

  <div class="absolute right-4 sm:right-8 bottom-6 z-10 flex items-center gap-2 text-white/70 text-xs uppercase tracking-[0.15em]">
    Swipe to slide
    <Icon name="lucide:arrow-right" size={16} />
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";

  new Swiper("#heroSwiper", {
    modules: [Autoplay, Pagination],
    loop: true,
    speed: 1000,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
    pagination: {
      el: ".swiper-pagination",
      type: "progressbar",
    },
  });
</script>
