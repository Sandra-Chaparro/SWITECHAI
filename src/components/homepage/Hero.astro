---
import { Image } from "astro:assets";
---

<section
  class="section-hero bg-gray-50 py-10 lg:py-20 bg-no-repeat bg-cover relative overflow-hidden z-0"
>
  <Image
    src="/img/bg/herobg.jpg"
    alt=""
    width={1200}
    height={600}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={45}
    class="absolute inset-0 w-full h-full object-cover object-top -z-10 opacity-40"
  />
  <div class="absolute inset-0 bg-white/80 dark:bg-black/80 md:bg-transparent -z-10"></div>
  <div class="container z-10">
    <div class="sm:max-w-md md:max-w-xl text-center sm:text-left">
      <p class="text-sm mb-1">BUILD. OPTIMIZE. GROW.</p>
      <h1>DIGITAL SOLUTIONS BUILT FOR YOUR BUSINESS.</h1>
      <p>
        From building your website to implementing SEO strategies, we help your business build a stronger online presence and grow.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-sm mx-auto sm:mx-0">
        <a
          href="/contact"
          class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
          >Contact Us</a
        >
        <a
          href="/service"
          class="btn btn-outline hover:bg-white hover:border-white rounded-lg"
          >See services</a
        >
      </div>
    </div>
  </div>
</section>
