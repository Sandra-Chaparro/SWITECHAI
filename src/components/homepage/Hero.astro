---
import { Image } from "astro:assets";
---

<section
  class="section-hero bg-gray-50 py-10 lg:py-20 bg-no-repeat bg-cover relative overflow-hidden z-0"
>
  <Image
    src="/img/bg/herobg.jpg"
    alt=""
    width={1200}
    height={600}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={45}
    class="absolute inset-0 w-full h-full object-cover object-top -z-10 opacity-40"
  />
  <div class="absolute inset-0 bg-white/80 dark:bg-black/80 md:bg-transparent -z-10"></div>
  <div
    class="absolute -top-24 -left-24 w-[28rem] h-[28rem] bg-main/10 blur-3xl rounded-full -z-10 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div class="container z-10">
    <div class="sm:max-w-md md:max-w-xl text-center sm:text-left">
      <p class="kicker justify-center sm:justify-start">Websites • SEO • Growth</p>
      <h1>DIGITAL SOLUTIONS BUILT FOR YOUR BUSINESS.</h1>
      <p class="max-w-md mx-auto sm:mx-0 text-gray-600 dark:text-white/70">
        We design and build modern websites for your business—using the right strategies to help you get found online, build customer trust, and grow.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-sm mx-auto sm:mx-0">
        <a
          href="/contact"
          class="btn-brand btn-lg"
          >Start Project</a
        >
        <a
          href="/service"
          class="btn-brand-outline btn-lg dark:text-white dark:border-white/30 dark:hover:border-main"
          >View Services</a
        >
      </div>
    </div>
  </div>
</section>
