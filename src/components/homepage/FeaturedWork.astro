---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import drTile from "../../assets/portfolio/dr-tile-solutions.jpg";
import mcTheBarber from "../../assets/portfolio/mc-the-barber.jpg";

const projects = [
  {
    name: "DR Tile Solutions",
    tag: "Remodeling & Flooring Contractor · Dallas-Fort Worth, TX",
    description:
      "A clean, conversion-focused website for a home remodeling and flooring contractor — built with a project gallery, clear service breakdown, and an easy quote-request flow to turn visitors into leads.",
    url: "https://drtile-solutions.vercel.app/",
    image: drTile,
  },
  {
    name: "MC the Barber",
    tag: "Barbershop · Allen, TX",
    description:
      "A stylish booking site for a barbershop client — featuring services, hours, a photo gallery, and an easy way for clients to book an appointment online.",
    url: "https://mcthebarber.com/",
    image: mcTheBarber,
  },
];
---

<section class="section section-featured-work">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="kicker justify-center">Featured Work</p>
      <h2>Websites We've Designed &amp; Built.</h2>
      <p class="text-gray-600 dark:text-white/70">
        A look at real projects for real businesses.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      {
        projects.map((project, i) => (
          <article
            class="group rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-premium hover:border-main/30"
            data-reveal
            style={`--reveal-delay: ${i * 0.15}s`}
          >
            <div class="bg-gray-100 border-b border-gray-200 overflow-hidden">
              <div class="flex items-center gap-1.5 px-4 py-3">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400" />
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400" />
                <span class="w-2.5 h-2.5 rounded-full bg-green-400" />
              </div>
              <Image
                src={project.image}
                alt={`Screenshot of the ${project.name} website`}
                width={900}
                height={506}
                format="webp"
                quality={80}
                class="w-full aspect-video object-cover object-top transition-transform duration-300 group-hover:scale-105"
              />
            </div>

            <div class="p-6 sm:p-8">
              <h3 class="font-display font-semibold text-xl sm:text-2xl mb-1 text-gray-900">
                {project.name}
              </h3>
              <p class="text-main text-sm font-semibold mb-4">{project.tag}</p>
              <p class="text-gray-600 mb-6">{project.description}</p>

              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-brand-outline"
              >
                View Project
                <Icon
                  name="lucide:arrow-up-right"
                  size={16}
                  class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
