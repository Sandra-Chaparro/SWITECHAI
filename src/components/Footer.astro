        </div>
        <div class="grid grid-cols-2 gap-10">
          <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Compañia</h3>
            <a href="#" class="hover:underline hover:text-main">Quienes Somos</a>
            <a href="/service" class="hover:underline hover:text-main"
              >Servicios</a
            >
          </nav>
          <!-- <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Know More</h3>
            <a href="#" class="hover:underline hover:text-main">Support</a>
            <a href="/policy" class="hover:underline hover:text-main"
              >Privacy Policy</a
            >
            <a href="/terms" class="hover:underline hover:text-main"
              >Terms & conditions</a
            >
          </nav> -->
        </div>
