---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/og_1200x630.png";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = FallbackImage,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<Font cssVariable="--font-display" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{`${SITE_TITLE} | ${title}`}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- JSON-LD Structured Data -->
<script async type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Business",
    "name": "Salvatierra Digital",
    "brand": "Salvatierra Digital",
    "alternateName": "Salvatierra Digital",
    "url": "#",
    "logo": "/favicon/logo.png",
    "description": "Website creation, SEO, and digital growth services for businesses.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Main St",
      "addressLocality": "Dallas",
      "addressRegion": "Dallas",
      "postalCode": "75201",
      "addressCountry": "TX"
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "+526144667011",
        "email": "salvatierradigital@gmail.com",
        "contactType": "customer support",
        "areaServed": "EN",
        "availableLanguage": ["English"]
      }
    ],
    "sameAs": [
      "https://www.facebook.com/profile.php?id=61578475133669"
    ]
  }
</script>
