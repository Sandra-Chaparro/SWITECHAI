---
import Image from "astro/components/Image.astro";
const { mode = "light" } = Astro.props;
---

<a href="/" class="logo">
  <Image
    src="/favicon/logo.png"
    alt="logo"
    width="332"
    height="347"
    fetchpriority="high"
    loading="eager"
    class="h-10 w-auto lg:h-12 dark:hidden"
  />
  <Image
    src="/favicon/logo.png"
    alt="logo"
    width="332"
    height="347"
    loading="eager"
    class="hidden h-10 w-auto lg:h-12 dark:block"
  />
</a>
